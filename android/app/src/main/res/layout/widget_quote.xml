<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/w_bg">
    <TextView android:id="@+id/cat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A59D8F" android:textSize="11sp" android:letterSpacing="0.12" />
    <TextView android:id="@+id/quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="4" android:ellipsize="end" />
    <TextView android:id="@+id/lvl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#E8B48A" android:textSize="12sp" />
    <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/w_bar" android:max="100" />
</LinearLayout>
